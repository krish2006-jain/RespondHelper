# Dependencies
node_modules/
*/node_modules/

# Production Build Artifacts
dist/
client/dist/
build/
.output/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.env
client/.env
server/.env
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Server Uploads (exclude uploaded files, preserve folder structure)
server/uploads/*
!server/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# Cache & Diagnostics
.vite/
client/.vite/
.eslintcache
.cache/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
