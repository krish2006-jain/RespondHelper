# ==========================================
# FRONTEND PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# Backend API Base URL (must end with /api/v1)
# Replace with your deployed backend URL (e.g. on Render, Railway, etc.)
VITE_API_BASE_URL=https://your-backend-app.onrender.com/api/v1

# Real-time WebSocket Server URL (root of backend, no /api/v1)
VITE_SOCKET_URL=https://your-backend-app.onrender.com

# Platform Branding & Details
VITE_APP_NAME=Relief Network
VITE_EMERGENCY_HELPLINE=112

# Map Configuration Defaults (Mumbai Center)
VITE_DEFAULT_MAP_LAT=19.0760
VITE_DEFAULT_MAP_LNG=72.8777
VITE_DEFAULT_MAP_ZOOM=12
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
