# ==========================================
# BACKEND PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# Node Environment & Server Port
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

# Frontend URLs for CORS & Redirects (replace with your deployed frontend URL)
CLIENT_URL=https://your-frontend-app.vercel.app
CORS_ORIGINS=https://your-frontend-app.vercel.app

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/disaster_platform?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB_NAME=disaster_platform

# JWT Authentication Secrets
# (Generate random 32+ character strings for production)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long_2026
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long_2026
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
COOKIE_SECRET=your_cookie_encryption_secret_key_2026

# Platform Admin Seed Credentials
ADMIN_NAME=Command Center Admin
ADMIN_EMAIL=admin@relief.org
ADMIN_PASSWORD=Admin@12345
ADMIN_PHONE=+919876543210

# Upload Configuration
UPLOAD_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=25
MAX_DOCUMENT_SIZE_MB=10
MAX_FILES_PER_REQUEST=5

# Map Coordinates Default (Mumbai Center)
MAP_PROVIDER=osm
DEFAULT_MAP_LAT=19.0760
DEFAULT_MAP_LNG=72.8777
DEFAULT_MAP_ZOOM=11

# Matching Engine Configuration
MATCH_DEFAULT_RADIUS_KM=25
MATCH_MAX_RADIUS_KM=100
MATCH_MAX_RESULTS=5

RESOURCE_WEIGHT_URGENCY=0.30
RESOURCE_WEIGHT_DISTANCE=0.30
RESOURCE_WEIGHT_QUANTITY=0.25
RESOURCE_WEIGHT_AVAILABILITY=0.15

VOLUNTEER_WEIGHT_DISTANCE=0.30
VOLUNTEER_WEIGHT_SKILL=0.25
VOLUNTEER_WEIGHT_PRIORITY=0.20
VOLUNTEER_WEIGHT_AVAILABILITY=0.15
VOLUNTEER_WEIGHT_WORKLOAD=0.10
VOLUNTEER_MAX_ACTIVE_TASKS=2

LOW_STOCK_THRESHOLD_PERCENT=20
EXPIRING_SOON_DAYS=7
INVENTORY_CRON_SCHEDULE=0 * * * *

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=30
SOS_RATE_LIMIT_MAX=30
ACCOUNT_LOCK_MAX_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
