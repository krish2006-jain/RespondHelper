# =====================================================================
# DISASTER MANAGEMENT & EMERGENCY RESPONSE PLATFORM - ENVIRONMENT FILE
# Copy this file to `.env` (server) and fill in real values.
# NEVER commit the real .env to Git. Add `.env` to .gitignore.
# =====================================================================

# ---------------------------------------------------------------------
# 1. SERVER
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------
# 2. DATABASE (MongoDB)
# ---------------------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/disaster_platform
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/disaster_platform
MONGO_URI=mongodb://127.0.0.1:27017/disaster_platform
MONGO_DB_NAME=disaster_platform

# ---------------------------------------------------------------------
# 3. AUTHENTICATION (JWT + bcrypt)
# ---------------------------------------------------------------------
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
COOKIE_SECRET=replace_with_cookie_secret
COOKIE_SECURE=false            # set true in production (HTTPS)
COOKIE_SAME_SITE=lax           # use "none" only if client/server are on different domains + HTTPS

# Forgot password / email verification
RESET_PASSWORD_TOKEN_EXPIRES_MIN=30
EMAIL_VERIFY_TOKEN_EXPIRES_HOURS=24

# ---------------------------------------------------------------------
# 4. FIRST ADMIN (used by the seed script only)
# ---------------------------------------------------------------------
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisStrongPassword123!
ADMIN_PHONE=+910000000000

# ---------------------------------------------------------------------
# 5. EMAIL (forgot password, verification results, alerts)
# ---------------------------------------------------------------------
# Gmail SMTP needs an "App Password"; or use Mailtrap for development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Relief Network <no-reply@example.com>"

# ---------------------------------------------------------------------
# 6. SMS / CALL ALERTS (optional - critical alerts)
# ---------------------------------------------------------------------
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------------
# 7. FILE & MEDIA UPLOADS (photos, videos, verification documents)
# ---------------------------------------------------------------------
# Option A: Cloudinary (recommended)
UPLOAD_PROVIDER=cloudinary     # cloudinary | local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=disaster-platform

# Option B: local disk (development only)
LOCAL_UPLOAD_DIR=uploads

# Upload validation
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=25
MAX_DOCUMENT_SIZE_MB=10
MAX_FILES_PER_REQUEST=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/webm
ALLOWED_DOCUMENT_TYPES=application/pdf,image/jpeg,image/png

# ---------------------------------------------------------------------
# 8. MAPS & LOCATION
# ---------------------------------------------------------------------
# Default stack: Leaflet + OpenStreetMap tiles (no key needed)
MAP_PROVIDER=osm               # osm | mapbox | google
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
# Optional routing / directions (OpenRouteService, free tier)
ORS_API_KEY=
# Default map centre (Mumbai) and zoom
DEFAULT_MAP_LAT=19.0760
DEFAULT_MAP_LNG=72.8777
DEFAULT_MAP_ZOOM=11

# ---------------------------------------------------------------------
# 9. MATCHING ENGINE (tune without touching code)
# ---------------------------------------------------------------------
# Search radius in km
MATCH_DEFAULT_RADIUS_KM=25
MATCH_MAX_RADIUS_KM=100
MATCH_MAX_RESULTS=5

# Resource matching weights (should sum to 1.0)
RESOURCE_WEIGHT_URGENCY=0.30
RESOURCE_WEIGHT_DISTANCE=0.30
RESOURCE_WEIGHT_QUANTITY=0.25
RESOURCE_WEIGHT_AVAILABILITY=0.15

# Volunteer matching weights (should sum to 1.0)
VOLUNTEER_WEIGHT_DISTANCE=0.30
VOLUNTEER_WEIGHT_SKILL=0.25
VOLUNTEER_WEIGHT_PRIORITY=0.20
VOLUNTEER_WEIGHT_AVAILABILITY=0.15
VOLUNTEER_WEIGHT_WORKLOAD=0.10

# Max simultaneous active tasks per volunteer
VOLUNTEER_MAX_ACTIVE_TASKS=2

# ---------------------------------------------------------------------
# 10. INVENTORY ALERT THRESHOLDS
# ---------------------------------------------------------------------
LOW_STOCK_THRESHOLD_PERCENT=20
EXPIRING_SOON_DAYS=7
INVENTORY_CRON_SCHEDULE=0 * * * *      # hourly check for low stock / expiry

# ---------------------------------------------------------------------
# 11. REAL-TIME (Socket.io)
# ---------------------------------------------------------------------
SOCKET_ENABLED=true
SOCKET_CORS_ORIGIN=http://localhost:5173
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000

# ---------------------------------------------------------------------
# 12. SECURITY & RATE LIMITING
# ---------------------------------------------------------------------
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=10                 # login / register / forgot-password attempts per window
SOS_RATE_LIMIT_MAX=10                  # emergency requests per user per window
ACCOUNT_LOCK_MAX_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY=false

# ---------------------------------------------------------------------
# 13. LOGGING
# ---------------------------------------------------------------------
LOG_LEVEL=info                         # error | warn | info | debug
LOG_TO_FILE=false

# =====================================================================
# CLIENT (React + Vite) - put these in client/.env
# Only variables prefixed with VITE_ are exposed to the browser.
# NEVER put secrets here.
# =====================================================================
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
VITE_MAP_PROVIDER=osm
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAPBOX_TOKEN=
VITE_DEFAULT_MAP_LAT=19.0760
VITE_DEFAULT_MAP_LNG=72.8777
VITE_DEFAULT_MAP_ZOOM=11
VITE_APP_NAME=Relief Network
VITE_EMERGENCY_HELPLINE=112
